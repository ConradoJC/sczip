#!/bin/bash
set -euo pipefail

VERSION="1.0.0"

# O sczip sempre trabalha no diretório de onde foi executado.
ROOT_DIR="$(pwd)"
ROOT_NAME="$(basename "$ROOT_DIR")"
IGNORE_FILE="$ROOT_DIR/.scignore"
TIMESTAMP="$(date '+%Y-%m-%d_%H-%M-%S')"
OUTPUT="$ROOT_DIR/backup_${ROOT_NAME}_${TIMESTAMP}.zip"

die() {
    echo "Erro: $*" >&2
    exit 1
}

command -v rsync >/dev/null 2>&1 || die "rsync não está instalado."
command -v zip >/dev/null 2>&1 || die "zip não está instalado."

if [[ -e "$OUTPUT" ]]; then
    die "O arquivo de saída já existe: $OUTPUT"
fi

# Converte as regras do .scignore em filtros do rsync.
build_rsync_filter() {
    local line pattern
    local -a filters=()

    # O .scignore não faz parte do backup.
    filters+=( "--exclude=/.scignore" )

    # O próprio ZIP também não pode entrar no backup.
    filters+=( "--exclude=/$(basename "$OUTPUT")" )

    if [[ -f "$IGNORE_FILE" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            line="${line%$'\r'}"

            # Linha vazia.
            [[ -z "${line//[[:space:]]/}" ]] && continue

            # Comentário.
            [[ "$line" == \#* ]] && continue

            # Escaped #.
            if [[ "$line" == \\\#* ]]; then
                line="${line:1}"
            fi

            # ! = re-incluir.
            if [[ "$line" == !* ]]; then
                pattern="${line:1}"
                [[ -z "$pattern" ]] && continue

                filters+=( "--filter=+ ${pattern}" )
            else
                filters+=( "--exclude=${line}" )
            fi
        done < "$IGNORE_FILE"
    fi

    printf '%s\0' "${filters[@]}"
}

mapfile -d '' FILTER_ARGS < <(build_rsync_filter)

echo
echo "========================================"
echo " SCZIP v${VERSION}"
echo "========================================"
echo
echo "Diretório:"
echo "  $ROOT_DIR"
echo

if [[ -f "$IGNORE_FILE" ]]; then
    echo "Ignore:"
    echo "  $IGNORE_FILE"
else
    echo "Ignore:"
    echo "  nenhum .scignore encontrado"
fi

echo
echo "Calculando conteúdo..."
echo

# Diretório temporário somente para o dry-run.
STATS_DIR="$(mktemp -d)"
trap 'rm -rf "$STATS_DIR"' EXIT INT TERM

STATS="$(
    rsync -rlt \
        --dry-run \
        --stats \
        --prune-empty-dirs \
        --from0 \
        "${FILTER_ARGS[@]}" \
        "$ROOT_DIR/" "$STATS_DIR/" 2>/dev/null
)"

rm -rf "$STATS_DIR"

TOTAL_BYTES="$(
    awk -F': ' '/Total transferred file size:/ {
        gsub(/ bytes$/, "", $2)
        print $2
    }' <<< "$STATS"
)"

TOTAL_FILES="$(
    awk -F': ' '/Number of regular files transferred:/ {
        print $2
    }' <<< "$STATS"
)"

TOTAL_BYTES="${TOTAL_BYTES:-0}"
TOTAL_FILES="${TOTAL_FILES:-0}"

if command -v numfmt >/dev/null 2>&1; then
    HUMAN_SIZE="$(numfmt --to=iec-i --suffix=B "$TOTAL_BYTES")"
else
    HUMAN_SIZE="${TOTAL_BYTES} bytes"
fi

echo "Arquivos:"
echo "  $TOTAL_FILES"
echo
echo "Tamanho a compactar:"
echo "  $HUMAN_SIZE"
echo

read -r -p "Criar o ZIP? [y/N]: " ANSWER

case "$ANSWER" in
    y|Y|s|S|yes|Yes|YES|sim|Sim|SIM)
        ;;
    *)
        echo
        echo "Operação cancelada."
        exit 0
        ;;
esac

echo
echo "Criando:"
echo "  $OUTPUT"
echo

STAGE="$(mktemp -d)"

cleanup() {
    rm -rf "$STAGE"
}

trap cleanup EXIT INT TERM

# Copia exatamente os mesmos arquivos selecionados pelo filtro.
rsync -a \
    --prune-empty-dirs \
    --from0 \
    "${FILTER_ARGS[@]}" \
    "$ROOT_DIR/" "$STAGE/"

(
    cd "$STAGE"
    zip -qr "$OUTPUT" .
)

FINAL_SIZE="$(du -h "$OUTPUT" | cut -f1)"

echo
echo "========================================"
echo " Backup concluído"
echo "========================================"
echo
echo "Arquivo:"
echo "  $OUTPUT"
echo
echo "Tamanho do ZIP:"
echo "  $FINAL_SIZE"
echo